{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.mjs", "tests/**/*.mjs", "*.mjs", "public/**/*.js"]
}
